<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>UnicoreSoftwareSolutions.Base.APIService</PackageId>
    <Version>1.0.0</Version>
    <Authors>Unicore Software Solutions</Authors>
    <Product>USS.Base.APIService</Product>
    <RepositoryUrl>https://github.com/unicoresoftwaresolutions/USS.Base.APIService</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <WebPage>https://unicoresoftwaresolutions.com/</WebPage>
    <IsPackable>true</IsPackable>

  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
    <None Include="LICENSE.txt" Pack="true" PackagePath=""/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageReference Include="UnicoreSoftwareSolutions.Base.Business.Interface" Version="1.0.0" />
  </ItemGroup>
</Project>
